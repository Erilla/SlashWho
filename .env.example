# Web and worker persistence
DATABASE_URL=postgresql://slashwho:slashwho@localhost:5432/slashwho

# Public API caller classification and hashed rate-limit buckets
BOT_API_KEY=replace-with-at-least-32-random-characters
RATE_LIMIT_HASH_SECRET=replace-with-at-least-32-random-characters

# Search and public-read policy (web service)
ANONYMOUS_SEARCHES_PER_HOUR=10
BOT_SEARCHES_PER_HOUR=60
PUBLIC_READS_PER_MINUTE=300
FRESHNESS_HOURS=24

# Worker lifecycle and discovery budget
DISCOVERY_REQUEST_CAP=12

# Raider.IO gateway (worker discovery and web dossier reads)
RAIDER_IO_BASE_URL=https://raider.io
RAIDER_IO_TIMEOUT_MS=10000
# Optional. A Raider.IO API key raises our rate limit above the anonymous
# allowance. Leave it unset to call Raider.IO anonymously, which is the
# supported default for local development. Treat a real value as a secret:
# it belongs in the deployment's variables, never in a committed file.
# RAIDER_IO_ACCESS_KEY=
# How long a confirmed absence is cached. Default 300000 ms (5 minutes).
NEGATIVE_CACHE_TTL_MS=300000
DATABASE_STARTUP_ATTEMPTS=5
DATABASE_STARTUP_RETRY_MS=1000
WORKER_DRAIN_TIMEOUT_MS=30000
WORKER_HEALTH_HOST=127.0.0.1

# Applicant dossier web service only. Keep OAuth credentials out of browser
# configuration, client bundles, logs, and route responses.
WARCRAFT_LOGS_CLIENT_ID=replace-with-warcraft-logs-client-id
WARCRAFT_LOGS_CLIENT_SECRET=replace-with-warcraft-logs-client-secret
# Optional test-only override; leave unset in production.
# WARCRAFT_LOGS_BASE_URL=https://www.warcraftlogs.com
# Shared between web and worker: encrypts a visitor-supplied WarcraftLogs key
# while its evidence job is queued. Must be identical in both environments.
# 64 hex characters (32 bytes). Generate with: openssl rand -hex 32
EVIDENCE_JOB_CREDENTIAL_ENCRYPTION_KEY=replace-with-64-hex-characters
DOSSIER_CHARACTER_CAP=12
DOSSIER_WARCRAFT_LOGS_REQUEST_CAP=80
DOSSIER_WARCRAFT_LOGS_TIMEOUT_MS=15000
DOSSIER_INITIAL_WARCRAFT_LOGS_REQUEST_CAP=20
DOSSIER_INITIAL_WARCRAFT_LOGS_TIMEOUT_MS=8000
# Ranking hydration is separately capped; the cap includes the bounded
# canonical identity lookups needed for exact attribution.
EVIDENCE_PARSE_REQUEST_CAP=24
# How long a run that exhausted its parse budget waits before it can collect
# again. Without a retry the run stays fresh for 24 hours and never resumes.
EVIDENCE_PARSE_CAP_RETRY_MS=1800000
# How much of the Warcraft Logs hourly points allowance must remain before an
# evidence run may start. 5000 is measured, not guessed: 19 collections logged
# on 2026-09-18 cost 862 to 4775 points (median 1609), and 5000 covers the
# maximum. See the comment in apps/worker/src/config.ts for the derivation.
# Capped in code at 30% of whatever allowance the account in use reports.
EVIDENCE_POINTS_RESERVE=5000
# Days after a kill before its rankings are taken as settled. Until then the
# fight is re-read and its tier cannot stop being collected. 7 is a guess and
# is explicitly unverified; setting it too low freezes a wrong percentile
# permanently. The observation time now stored with each percentile is what
# should replace it with a measurement.
EVIDENCE_KILL_SETTLE_DAYS=7

# Blizzard achievement-fingerprint sweeps (worker service only). The
# credentials and the per-sweep request cap are required; the remaining
# settings fall back to the shared budget, threshold, and cadence decisions.
BLIZZARD_CLIENT_ID=replace-with-the-battle-net-client-id
BLIZZARD_CLIENT_SECRET=replace-with-the-battle-net-client-secret
BLIZZARD_SWEEP_REQUEST_CAP=300
BLIZZARD_HOURLY_REQUEST_BUDGET=28800
FINGERPRINT_MINIMUM_COMMON=200
FINGERPRINT_MINIMUM_IDENTICAL_PERCENT=20
FINGERPRINT_SWEEP_CADENCE_HOURS=168

# Changelog page (optional)
# Optional; requires a repository name (owner/repo) and GitHub API access.
#SLASHWHO_CHANGELOG_REPOSITORY=owner/repo
#SLASHWHO_CHANGELOG_ENVIRONMENTS=production
#SLASHWHO_CHANGELOG_MAX_ENTRIES=20
#SLASHWHO_GITHUB_TOKEN=github_pat_xxx

# Optional chat sink announcing each discovery run as it starts, rendered as a
# Discord message. Announced once per execution, so a retry and a continuation
# each post. The whole URL is the secret, path included. Leave it unset to
# announce nothing.
# DISCOVERY_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/token

# Optional internal alert sink for budget and admission pressure. Its path and
# query string are part of the secret, so the whole URL is used as given.
# MAINTAINER_ALERT_WEBHOOK_URL=https://hooks.example.test/services/T000/B000/token
