# Web and worker persistence
DATABASE_URL=postgresql://slashwho:slashwho@localhost:5432/slashwho

# Public API caller classification and hashed rate-limit buckets
BOT_API_KEY=replace-with-at-least-32-random-characters
RATE_LIMIT_HASH_SECRET=replace-with-at-least-32-random-characters

# Search and public-read policy
ANONYMOUS_SEARCHES_PER_HOUR=10
BOT_SEARCHES_PER_HOUR=60
PUBLIC_READS_PER_MINUTE=300
FRESHNESS_HOURS=24
NEGATIVE_CACHE_MINUTES=15
DISCOVERY_REQUEST_CAP=12

# Worker lifecycle and sanitized Raider.IO gateway
RAIDER_IO_BASE_URL=https://raider.io
RAIDER_IO_TIMEOUT_MS=10000
NEGATIVE_CACHE_TTL_MS=300000
DATABASE_STARTUP_ATTEMPTS=5
DATABASE_STARTUP_RETRY_MS=1000
WORKER_DRAIN_TIMEOUT_MS=30000
WORKER_HEALTH_HOST=127.0.0.1
