FROM node:22.15.0-alpine AS build

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
WORKDIR /workspace

RUN corepack enable && corepack prepare pnpm@11.20.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/application/package.json packages/application/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/domain/package.json packages/domain/package.json
COPY packages/raiderio/package.json packages/raiderio/package.json
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm --filter @slashwho/worker build
RUN pnpm --config.inject-workspace-packages=true --filter @slashwho/worker deploy --prod /out/worker
RUN pnpm --config.inject-workspace-packages=true --filter @slashwho/database deploy --prod /out/migrate

FROM node:22.15.0-alpine AS runtime

ENV NODE_ENV=production
ENV PORT=3001
ENV WORKER_HEALTH_HOST=0.0.0.0
ENV SLASHWHO_MIGRATIONS_FOLDER=/app/migrate/drizzle
WORKDIR /app/worker

COPY --from=build --chown=node:node /out/worker /app/worker
COPY --from=build --chown=node:node /out/migrate /app/migrate

USER node
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3001)+'/ready').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

CMD ["/bin/sh", "-c", "/app/migrate/node_modules/.bin/tsx /app/migrate/src/cli-migrate.ts && exec /app/worker/node_modules/.bin/tsx /app/worker/src/main.ts"]
